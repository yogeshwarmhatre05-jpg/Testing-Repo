import "dotenv/config";
import express from "express";
import cors from "cors";
import rateLimit from "express-rate-limit";
import Anthropic from "@anthropic-ai/sdk";

const app = express();
const PORT = process.env.PORT || 8787;
const ORIGINS = (process.env.CORS_ORIGIN || "http://localhost:5173").split(",");

// The API key is only ever read here, on the server. It is never sent
// to, or readable by, the frontend bundle.
const anthropic = new Anthropic({ apiKey: process.env.ANTHROPIC_API_KEY });

// "fast" / "reasoning" / "local" are the labels the UI shows the user;
// map each to a real upstream model id here so the frontend never needs
// to know provider-specific model names.
const MODEL_MAP = {
  fast: "claude-haiku-4-5-20251001",
  reasoning: process.env.DEFAULT_MODEL || "claude-sonnet-5",
  local: null, // handled by a separate local-inference server, see README
};

app.use(cors({ origin: ORIGINS }));
app.use(express.json({ limit: "10mb" }));

// Basic abuse prevention: cap requests per IP. Tune for real traffic.
app.use(
  "/api/",
  rateLimit({
    windowMs: 60 * 1000,
    max: 30,
    standardHeaders: true,
    legacyHeaders: false,
  })
);

app.get("/api/health", (_req, res) => res.json({ ok: true }));

app.post("/api/chat", async (req, res) => {
  const { messages, model } = req.body ?? {};

  if (!Array.isArray(messages) || messages.length === 0) {
    return res
      .status(400)
      .json({ error: "messages must be a non-empty array" });
  }

  const upstreamModel = MODEL_MAP[model] ?? MODEL_MAP.fast;
  if (!upstreamModel) {
    return res.status(400).json({
      error:
        "This model runs on a separate local-inference server. See backend/README for setup.",
    });
  }

  // Set up Server-Sent Events so the frontend can render tokens as they arrive.
  res.setHeader("Content-Type", "text/event-stream");
  res.setHeader("Cache-Control", "no-cache");
  res.setHeader("Connection", "keep-alive");
  res.flushHeaders?.();

  const send = (data) => res.write(`data: ${JSON.stringify(data)}\n\n`);

  const abortController = new AbortController();
  req.on("close", () => abortController.abort());

  try {
    const stream = anthropic.messages.stream(
      {
        model: upstreamModel,
        max_tokens: 1024,
        messages: messages.map((m) => ({ role: m.role, content: m.content })),
      },
      { signal: abortController.signal }
    );

    stream.on("text", (delta) => send({ delta }));

    await stream.finalMessage();
    res.write("data: [DONE]\n\n");
    res.end();
  } catch (err) {
    if (!res.writableEnded) {
      send({ error: err instanceof Error ? err.message : "Upstream error" });
      res.write("data: [DONE]\n\n");
      res.end();
    }
  }
});

app.listen(PORT, () => {
  console.log(`Ledger backend listening on http://localhost:${PORT}`);
});